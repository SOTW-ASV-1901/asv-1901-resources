{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "LAM",
  "chapter": 3,
  "verses": [
    {
      "id": "LAM.3.1",
      "edition_verse_id": "ASV1901:LAM.3.1",
      "verse": 1,
      "spans": [
        {
          "text": "I am the man that hath seen affliction by the rod of his wrath.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.2",
      "edition_verse_id": "ASV1901:LAM.3.2",
      "verse": 2,
      "spans": [
        {
          "text": "He hath led me and caused me to walk in darkness, and not in light.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.3",
      "edition_verse_id": "ASV1901:LAM.3.3",
      "verse": 3,
      "spans": [
        {
          "text": "Surely against me he turneth his hand again and again all the day.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.4",
      "edition_verse_id": "ASV1901:LAM.3.4",
      "verse": 4,
      "spans": [
        {
          "text": "My flesh and my skin hath he made old; he hath broken my bones.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.5",
      "edition_verse_id": "ASV1901:LAM.3.5",
      "verse": 5,
      "spans": [
        {
          "text": "He hath builded against me, and compassed me with gall and travail.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.6",
      "edition_verse_id": "ASV1901:LAM.3.6",
      "verse": 6,
      "spans": [
        {
          "text": "He hath made me to dwell in dark places, as those that have been long dead.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.7",
      "edition_verse_id": "ASV1901:LAM.3.7",
      "verse": 7,
      "spans": [
        {
          "text": "He hath walled me about, that I cannot go forth; he hath made my chain heavy.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.8",
      "edition_verse_id": "ASV1901:LAM.3.8",
      "verse": 8,
      "spans": [
        {
          "text": "Yea, when I cry, and call for help, he shutteth out my prayer.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.9",
      "edition_verse_id": "ASV1901:LAM.3.9",
      "verse": 9,
      "spans": [
        {
          "text": "He hath walled up my ways with hewn stone; he hath made my paths crooked.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.10",
      "edition_verse_id": "ASV1901:LAM.3.10",
      "verse": 10,
      "spans": [
        {
          "text": "He is unto me as a bear lying in wait, as a lion in secret places.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.11",
      "edition_verse_id": "ASV1901:LAM.3.11",
      "verse": 11,
      "spans": [
        {
          "text": "He hath turned aside my ways, and pulled me in pieces; he hath made me desolate.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.12",
      "edition_verse_id": "ASV1901:LAM.3.12",
      "verse": 12,
      "spans": [
        {
          "text": "He hath bent his bow, and set me as a mark for the arrow.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.13",
      "edition_verse_id": "ASV1901:LAM.3.13",
      "verse": 13,
      "spans": [
        {
          "text": "He hath caused the shafts of his quiver to enter into my reins.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.14",
      "edition_verse_id": "ASV1901:LAM.3.14",
      "verse": 14,
      "spans": [
        {
          "text": "I am become a derision to all my people, and their song all the day.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.15",
      "edition_verse_id": "ASV1901:LAM.3.15",
      "verse": 15,
      "spans": [
        {
          "text": "He hath filled me with bitterness, he hath sated me with wormwood.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.16",
      "edition_verse_id": "ASV1901:LAM.3.16",
      "verse": 16,
      "spans": [
        {
          "text": "He hath also broken my teeth with gravel stones; he hath covered me with ashes.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.17",
      "edition_verse_id": "ASV1901:LAM.3.17",
      "verse": 17,
      "spans": [
        {
          "text": "And thou hast removed my soul far off from peace; I forgat prosperity.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.18",
      "edition_verse_id": "ASV1901:LAM.3.18",
      "verse": 18,
      "spans": [
        {
          "text": "And I said, My strength is perished, and mine expectation from Jehovah.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.19",
      "edition_verse_id": "ASV1901:LAM.3.19",
      "verse": 19,
      "spans": [
        {
          "text": "Remember mine affliction and my misery, the wormwood and the gall.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.20",
      "edition_verse_id": "ASV1901:LAM.3.20",
      "verse": 20,
      "spans": [
        {
          "text": "My soul hath them still in remembrance, and is bowed down within me.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.21",
      "edition_verse_id": "ASV1901:LAM.3.21",
      "verse": 21,
      "spans": [
        {
          "text": "This I recall to my mind; therefore have I hope.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.22",
      "edition_verse_id": "ASV1901:LAM.3.22",
      "verse": 22,
      "spans": [
        {
          "text": "It is of",
          "kind": "supplied"
        },
        {
          "text": " Jehovah’s lovingkindnesses that we are not consumed, because his compassions fail not.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.23",
      "edition_verse_id": "ASV1901:LAM.3.23",
      "verse": 23,
      "spans": [
        {
          "text": "They are new every morning; great is thy faithfulness.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.24",
      "edition_verse_id": "ASV1901:LAM.3.24",
      "verse": 24,
      "spans": [
        {
          "text": "Jehovah is my portion, saith my soul; therefore will I hope in him.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.25",
      "edition_verse_id": "ASV1901:LAM.3.25",
      "verse": 25,
      "spans": [
        {
          "text": "Jehovah is good unto them that wait for him, to the soul that seeketh him.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.26",
      "edition_verse_id": "ASV1901:LAM.3.26",
      "verse": 26,
      "spans": [
        {
          "text": "It is good that a man should hope and quietly wait for the salvation of Jehovah.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.27",
      "edition_verse_id": "ASV1901:LAM.3.27",
      "verse": 27,
      "spans": [
        {
          "text": "It is good for a man that he bear the yoke in his youth.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.28",
      "edition_verse_id": "ASV1901:LAM.3.28",
      "verse": 28,
      "spans": [
        {
          "text": "Let him sit alone and keep silence, because he hath laid it upon him.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.29",
      "edition_verse_id": "ASV1901:LAM.3.29",
      "verse": 29,
      "spans": [
        {
          "text": "Let him put his mouth in the dust, if so be there may be hope.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.30",
      "edition_verse_id": "ASV1901:LAM.3.30",
      "verse": 30,
      "spans": [
        {
          "text": "Let him give his cheek to him that smiteth him; let him be filled full with reproach.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.31",
      "edition_verse_id": "ASV1901:LAM.3.31",
      "verse": 31,
      "spans": [
        {
          "text": "For the Lord will not cast off for ever.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.32",
      "edition_verse_id": "ASV1901:LAM.3.32",
      "verse": 32,
      "spans": [
        {
          "text": "For though he cause grief, yet will he have compassion according to the multitude of his lovingkindnesses.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.33",
      "edition_verse_id": "ASV1901:LAM.3.33",
      "verse": 33,
      "spans": [
        {
          "text": "For he doth not afflict willingly, nor grieve the children of men.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.34",
      "edition_verse_id": "ASV1901:LAM.3.34",
      "verse": 34,
      "spans": [
        {
          "text": "To crush under foot all the prisoners of the earth,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.35",
      "edition_verse_id": "ASV1901:LAM.3.35",
      "verse": 35,
      "spans": [
        {
          "text": "To turn aside the right of a man before the face of the Most High,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.36",
      "edition_verse_id": "ASV1901:LAM.3.36",
      "verse": 36,
      "spans": [
        {
          "text": "To subvert a man in his cause, the Lord approveth not.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.37",
      "edition_verse_id": "ASV1901:LAM.3.37",
      "verse": 37,
      "spans": [
        {
          "text": "Who is he that saith, and it cometh to pass, when the Lord commandeth it not?",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.38",
      "edition_verse_id": "ASV1901:LAM.3.38",
      "verse": 38,
      "spans": [
        {
          "text": "Out of the mouth of the Most High cometh there not evil and good?",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.39",
      "edition_verse_id": "ASV1901:LAM.3.39",
      "verse": 39,
      "spans": [
        {
          "text": "Wherefore doth a living man complain, a man for the punishment of his sins?",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.40",
      "edition_verse_id": "ASV1901:LAM.3.40",
      "verse": 40,
      "spans": [
        {
          "text": "Let us search and try our ways, and turn again to Jehovah.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.41",
      "edition_verse_id": "ASV1901:LAM.3.41",
      "verse": 41,
      "spans": [
        {
          "text": "Let us lift up our heart with our hands unto God in the heavens.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.42",
      "edition_verse_id": "ASV1901:LAM.3.42",
      "verse": 42,
      "spans": [
        {
          "text": "We have transgressed and have rebelled; thou hast not pardoned.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.43",
      "edition_verse_id": "ASV1901:LAM.3.43",
      "verse": 43,
      "spans": [
        {
          "text": "Thou hast covered with anger and pursued us; thou hast slain, thou hast not pitied.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.44",
      "edition_verse_id": "ASV1901:LAM.3.44",
      "verse": 44,
      "spans": [
        {
          "text": "Thou hast covered thyself with a cloud, so that no prayer can pass through.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.45",
      "edition_verse_id": "ASV1901:LAM.3.45",
      "verse": 45,
      "spans": [
        {
          "text": "Thou hast made us an offscouring and refuse in the midst of the peoples.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.46",
      "edition_verse_id": "ASV1901:LAM.3.46",
      "verse": 46,
      "spans": [
        {
          "text": "All our enemies have opened their mouth wide against us.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.47",
      "edition_verse_id": "ASV1901:LAM.3.47",
      "verse": 47,
      "spans": [
        {
          "text": "Fear and the pit are come upon us, devastation and destruction.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.48",
      "edition_verse_id": "ASV1901:LAM.3.48",
      "verse": 48,
      "spans": [
        {
          "text": "Mine eye runneth down with streams of water, for the destruction of the daughter of my people.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.49",
      "edition_verse_id": "ASV1901:LAM.3.49",
      "verse": 49,
      "spans": [
        {
          "text": "Mine eye poureth down, and ceaseth not, without any intermission,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.50",
      "edition_verse_id": "ASV1901:LAM.3.50",
      "verse": 50,
      "spans": [
        {
          "text": "Till Jehovah look down, and behold from heaven.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.51",
      "edition_verse_id": "ASV1901:LAM.3.51",
      "verse": 51,
      "spans": [
        {
          "text": "Mine eye affecteth my soul, because of all the daughters of my city.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.52",
      "edition_verse_id": "ASV1901:LAM.3.52",
      "verse": 52,
      "spans": [
        {
          "text": "They have chased me sore like a bird, they that are mine enemies without cause.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.53",
      "edition_verse_id": "ASV1901:LAM.3.53",
      "verse": 53,
      "spans": [
        {
          "text": "They have cut off my life in the dungeon, and have cast a stone upon me.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.54",
      "edition_verse_id": "ASV1901:LAM.3.54",
      "verse": 54,
      "spans": [
        {
          "text": "Waters flowed over my head; I said, I am cut off.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.55",
      "edition_verse_id": "ASV1901:LAM.3.55",
      "verse": 55,
      "spans": [
        {
          "text": "I called upon thy name, O Jehovah, out of the lowest dungeon.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.56",
      "edition_verse_id": "ASV1901:LAM.3.56",
      "verse": 56,
      "spans": [
        {
          "text": "Thou heardest my voice; hide not thine ear at my breathing, at my cry.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.57",
      "edition_verse_id": "ASV1901:LAM.3.57",
      "verse": 57,
      "spans": [
        {
          "text": "Thou drewest near in the day that I called upon thee; thou saidst, Fear not.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.58",
      "edition_verse_id": "ASV1901:LAM.3.58",
      "verse": 58,
      "spans": [
        {
          "text": "O Lord, thou hast pleaded the causes of my soul; thou hast redeemed my life.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.59",
      "edition_verse_id": "ASV1901:LAM.3.59",
      "verse": 59,
      "spans": [
        {
          "text": "O Jehovah, thou hast seen my wrong; judge thou my cause.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.60",
      "edition_verse_id": "ASV1901:LAM.3.60",
      "verse": 60,
      "spans": [
        {
          "text": "Thou hast seen all their vengeance and all their devices against me.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.61",
      "edition_verse_id": "ASV1901:LAM.3.61",
      "verse": 61,
      "spans": [
        {
          "text": "Thou hast heard their reproach, O Jehovah, and all their devices against me,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.62",
      "edition_verse_id": "ASV1901:LAM.3.62",
      "verse": 62,
      "spans": [
        {
          "text": "The lips of those that rose up against me, and their device against me all the day.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.63",
      "edition_verse_id": "ASV1901:LAM.3.63",
      "verse": 63,
      "spans": [
        {
          "text": "Behold thou their sitting down, and their rising up; I am their song.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.64",
      "edition_verse_id": "ASV1901:LAM.3.64",
      "verse": 64,
      "spans": [
        {
          "text": "Thou wilt render unto them a recompense, O Jehovah, according to the work of their hands.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.65",
      "edition_verse_id": "ASV1901:LAM.3.65",
      "verse": 65,
      "spans": [
        {
          "text": "Thou wilt give them hardness of heart, thy curse unto them.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.66",
      "edition_verse_id": "ASV1901:LAM.3.66",
      "verse": 66,
      "spans": [
        {
          "text": "Thou wilt pursue them in anger, and destroy them from under the heavens of Jehovah.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ]
}
