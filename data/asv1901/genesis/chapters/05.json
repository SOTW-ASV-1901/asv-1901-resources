      "verse": 1,
      "spans": [
        {
          "text": "This is the book of the generations of Adam. In the day that God created man, in the likeness of God made he him;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "GEN.5.2",
      "edition_verse_id": "ASV1901:GEN.5.2",
      "verse": 2,
      "spans": [
        {
          "text": "male and female created he them, and blessed them, and called their name Adam, in the day when they were created.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.3",
      "edition_verse_id": "ASV1901:GEN.5.3",
      "verse": 3,
      "spans": [
        {
          "text": "And Adam lived a hundred and thirty years, and begat ",
          "kind": "text"
        },
        {
          "text": "a son",
          "kind": "supplied"
        },
        {
          "text": " in his own likeness, after his image; and called his name Seth:",
          "kind": "text"
        }
