{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PRO",
  "chapter": 12,
  "verses": [
    {
      "id": "PRO.12.1",
      "edition_verse_id": "ASV1901:PRO.12.1",
      "verse": 1,
      "spans": [
        {
          "text": "Whoso loveth correction loveth knowledge;\nBut he that hateth reproof is brutish.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.2",
      "edition_verse_id": "ASV1901:PRO.12.2",
      "verse": 2,
      "spans": [
        {
          "text": "A good man shall obtain favor of Jehovah;\nBut a man of wicked devices will he condemn.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.3",
      "edition_verse_id": "ASV1901:PRO.12.3",
      "verse": 3,
      "spans": [
        {
          "text": "A man shall not be established by wickedness;\nBut the root of the righteous shall not be moved.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.4",
      "edition_verse_id": "ASV1901:PRO.12.4",
      "verse": 4,
      "spans": [
        {
          "text": "A worthy woman is the crown of her husband;\nBut she that maketh ashamed is as rottenness in his bones.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.5",
      "edition_verse_id": "ASV1901:PRO.12.5",
      "verse": 5,
      "spans": [
        {
          "text": "The thoughts of the righteous are just;",
          "kind": "text"
        },
        {
          "text": "But",
          "kind": "supplied"
        },
        {
          "text": " the counsels of the wicked are deceit.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.6",
      "edition_verse_id": "ASV1901:PRO.12.6",
      "verse": 6,
      "spans": [
        {
          "text": "The words of the wicked are of lying in wait for blood;\nBut the mouth of the upright shall deliver them.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.7",
      "edition_verse_id": "ASV1901:PRO.12.7",
      "verse": 7,
      "spans": [
        {
          "text": "The wicked are overthrown, and are not;\nBut the house of the righteous shall stand.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.8",
      "edition_verse_id": "ASV1901:PRO.12.8",
      "verse": 8,
      "spans": [
        {
          "text": "A man shall be commended according to his wisdom;\nBut he that is of a perverse heart shall be despised.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.9",
      "edition_verse_id": "ASV1901:PRO.12.9",
      "verse": 9,
      "spans": [
        {
          "text": "Better is he that is lightly esteemed, and hath a servant,\nThan he that honoreth himself, and lacketh bread.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.10",
      "edition_verse_id": "ASV1901:PRO.12.10",
      "verse": 10,
      "spans": [
        {
          "text": "A righteous man regardeth the life of his beast;\nBut the tender mercies of the wicked are cruel.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.11",
      "edition_verse_id": "ASV1901:PRO.12.11",
      "verse": 11,
      "spans": [
        {
          "text": "He that tilleth his land shall have plenty of bread;\nBut he that followeth after vain ",
          "kind": "text"
        },
        {
          "text": "persons",
          "kind": "supplied"
        },
        {
          "text": " is void of understanding.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.12",
      "edition_verse_id": "ASV1901:PRO.12.12",
      "verse": 12,
      "spans": [
        {
          "text": "The wicked desireth the net of evil men;\nBut the root of the righteous yieldeth ",
          "kind": "text"
        },
        {
          "text": "fruit",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.13",
      "edition_verse_id": "ASV1901:PRO.12.13",
      "verse": 13,
      "spans": [
        {
          "text": "In the transgression of the lips is a snare to the evil man;\nBut the righteous shall come out of trouble.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.14",
      "edition_verse_id": "ASV1901:PRO.12.14",
      "verse": 14,
      "spans": [
        {
          "text": "A man shall be satisfied with good by the fruit of his mouth;\nAnd the doings of a man’s hands shall be rendered unto him.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.15",
      "edition_verse_id": "ASV1901:PRO.12.15",
      "verse": 15,
      "spans": [
        {
          "text": "The way of a fool is right in his own eyes;\nBut he that is wise hearkeneth unto counsel.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.16",
      "edition_verse_id": "ASV1901:PRO.12.16",
      "verse": 16,
      "spans": [
        {
          "text": "A fool’s vexation is presently known;\nBut a prudent man concealeth shame.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.17",
      "edition_verse_id": "ASV1901:PRO.12.17",
      "verse": 17,
      "spans": [
        {
          "text": "He that uttereth truth showeth forth righteousness;\nBut a false witness, deceit.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.18",
      "edition_verse_id": "ASV1901:PRO.12.18",
      "verse": 18,
      "spans": [
        {
          "text": "There is that speaketh rashly like the piercings of a sword;\nBut the tongue of the wise is health.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.19",
      "edition_verse_id": "ASV1901:PRO.12.19",
      "verse": 19,
      "spans": [
        {
          "text": "The lip of truth shall be established for ever;\nBut a lying tongue is but for a moment.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.20",
      "edition_verse_id": "ASV1901:PRO.12.20",
      "verse": 20,
      "spans": [
        {
          "text": "Deceit is in the heart of them that devise evil;\nBut to the counsellors of peace is joy.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.21",
      "edition_verse_id": "ASV1901:PRO.12.21",
      "verse": 21,
      "spans": [
        {
          "text": "There shall no mischief happen to the righteous;\nBut the wicked shall be filled with evil.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.22",
      "edition_verse_id": "ASV1901:PRO.12.22",
      "verse": 22,
      "spans": [
        {
          "text": "Lying lips are an abomination to Jehovah;\nBut they that deal truly are his delight.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.23",
      "edition_verse_id": "ASV1901:PRO.12.23",
      "verse": 23,
      "spans": [
        {
          "text": "A prudent man concealeth knowledge;\nBut the heart of fools proclaimeth foolishness.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.24",
      "edition_verse_id": "ASV1901:PRO.12.24",
      "verse": 24,
      "spans": [
        {
          "text": "The hand of the diligent shall bear rule;\nBut the slothful shall be put under taskwork.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.25",
      "edition_verse_id": "ASV1901:PRO.12.25",
      "verse": 25,
      "spans": [
        {
          "text": "Heaviness in the heart of a man maketh it stoop;\nBut a good word maketh it glad.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.26",
      "edition_verse_id": "ASV1901:PRO.12.26",
      "verse": 26,
      "spans": [
        {
          "text": "The righteous is a guide to his neighbor;\nBut the way of the wicked causeth them to err.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.27",
      "edition_verse_id": "ASV1901:PRO.12.27",
      "verse": 27,
      "spans": [
        {
          "text": "The slothful man roasteth not that which he took in hunting;\nBut the precious substance of men ",
          "kind": "text"
        },
        {
          "text": "is to",
          "kind": "supplied"
        },
        {
          "text": " the diligent.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.12.28",
      "edition_verse_id": "ASV1901:PRO.12.28",
      "verse": 28,
      "spans": [
        {
          "text": "In the way of righteousness is life;\nAnd in the pathway thereof there is no death.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ]
}
