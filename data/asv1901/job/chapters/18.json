{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "JOB",
  "chapter": 18,
  "verses": [
    {
      "id": "JOB.18.1",
      "edition_verse_id": "ASV1901:JOB.18.1",
      "verse": 1,
      "spans": [
        {
          "text": "Then answered Bildad the Shuhite, and said,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.2",
      "edition_verse_id": "ASV1901:JOB.18.2",
      "verse": 2,
      "spans": [
        {
          "text": "How long will ye hunt for words?\nConsider, and afterwards we will speak.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.3",
      "edition_verse_id": "ASV1901:JOB.18.3",
      "verse": 3,
      "spans": [
        {
          "text": "Wherefore are we counted as beasts,",
          "kind": "text"
        },
        {
          "text": "And",
          "kind": "supplied"
        },
        {
          "text": " are become unclean in your sight?",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.4",
      "edition_verse_id": "ASV1901:JOB.18.4",
      "verse": 4,
      "spans": [
        {
          "text": "Thou that tearest thyself in thine anger,\nShall the earth be forsaken for thee?\nOr shall the rock be removed out of its place?",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.5",
      "edition_verse_id": "ASV1901:JOB.18.5",
      "verse": 5,
      "spans": [
        {
          "text": "Yea, the light of the wicked shall be put out,\nAnd the spark of his fire shall not shine.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.6",
      "edition_verse_id": "ASV1901:JOB.18.6",
      "verse": 6,
      "spans": [
        {
          "text": "The light shall be dark in his tent,\nAnd his lamp above him shall be put out.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.7",
      "edition_verse_id": "ASV1901:JOB.18.7",
      "verse": 7,
      "spans": [
        {
          "text": "The steps of his strength shall be straitened,\nAnd his own counsel shall cast him down.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.8",
      "edition_verse_id": "ASV1901:JOB.18.8",
      "verse": 8,
      "spans": [
        {
          "text": "For he is cast into a net by his own feet,\nAnd he walketh upon the toils.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.9",
      "edition_verse_id": "ASV1901:JOB.18.9",
      "verse": 9,
      "spans": [
        {
          "text": "A gin shall take ",
          "kind": "text"
        },
        {
          "text": "him",
          "kind": "supplied"
        },
        {
          "text": " by the heel,",
          "kind": "text"
        },
        {
          "text": "And",
          "kind": "supplied"
        },
        {
          "text": " a snare shall lay hold on him.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.10",
      "edition_verse_id": "ASV1901:JOB.18.10",
      "verse": 10,
      "spans": [
        {
          "text": "A noose is hid for him in the ground,\nAnd a trap for him in the way.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.11",
      "edition_verse_id": "ASV1901:JOB.18.11",
      "verse": 11,
      "spans": [
        {
          "text": "Terrors shall make him afraid on every side,\nAnd shall chase him at his heels.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.12",
      "edition_verse_id": "ASV1901:JOB.18.12",
      "verse": 12,
      "spans": [
        {
          "text": "His strength shall be hunger-bitten,\nAnd calamity shall be ready at his side.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.13",
      "edition_verse_id": "ASV1901:JOB.18.13",
      "verse": 13,
      "spans": [
        {
          "text": "The members of his body shall be devoured,",
          "kind": "text"
        },
        {
          "text": "Yea",
          "kind": "supplied"
        },
        {
          "text": ", the first-born of death shall devour his members.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.14",
      "edition_verse_id": "ASV1901:JOB.18.14",
      "verse": 14,
      "spans": [
        {
          "text": "He shall be rooted out of his tent wherein he trusteth;\nAnd he shall be brought to the king of terrors.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.15",
      "edition_verse_id": "ASV1901:JOB.18.15",
      "verse": 15,
      "spans": [
        {
          "text": "There shall dwell in his tent that which is none of his:\nBrimstone shall be scattered upon his habitation.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.16",
      "edition_verse_id": "ASV1901:JOB.18.16",
      "verse": 16,
      "spans": [
        {
          "text": "His roots shall be dried up beneath,\nAnd above shall his branch be cut off.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.17",
      "edition_verse_id": "ASV1901:JOB.18.17",
      "verse": 17,
      "spans": [
        {
          "text": "His remembrance shall perish from the earth,\nAnd he shall have no name in the street.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.18",
      "edition_verse_id": "ASV1901:JOB.18.18",
      "verse": 18,
      "spans": [
        {
          "text": "He shall be driven from light into darkness,\nAnd chased out of the world.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.19",
      "edition_verse_id": "ASV1901:JOB.18.19",
      "verse": 19,
      "spans": [
        {
          "text": "He shall have neither son nor son’s son among his people,\nNor any remaining where he sojourned.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.20",
      "edition_verse_id": "ASV1901:JOB.18.20",
      "verse": 20,
      "spans": [
        {
          "text": "They that come after shall be astonished at his day,\nAs they that went before were affrighted.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOB.18.21",
      "edition_verse_id": "ASV1901:JOB.18.21",
      "verse": 21,
      "spans": [
        {
          "text": "Surely such are the dwellings of the unrighteous,\nAnd this is the place of him that knoweth not God.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ]
}
