{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PSA",
  "chapter": 86,
  "verses": [
    {
      "id": "PSA.86.1",
      "edition_verse_id": "ASV1901:PSA.86.1",
      "verse": 1,
      "spans": [
        {
          "text": "Bow down thine ear, O Jehovah, and answer me;\nFor I am poor and needy.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.86.2",
      "edition_verse_id": "ASV1901:PSA.86.2",
      "verse": 2,
      "spans": [
        {
          "text": "Preserve my soul; for I am godly:\nO thou my God, save thy servant that trusteth in thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.86.3",
      "edition_verse_id": "ASV1901:PSA.86.3",
      "verse": 3,
      "spans": [
        {
          "text": "Be merciful unto me, O Lord;\nFor unto thee do I cry all the day long.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.86.4",
      "edition_verse_id": "ASV1901:PSA.86.4",
      "verse": 4,
      "spans": [
        {
          "text": "Rejoice the soul of thy servant;\nFor unto thee, O Lord, do I lift up my soul.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.86.5",
      "edition_verse_id": "ASV1901:PSA.86.5",
      "verse": 5,
      "spans": [
        {
          "text": "For thou, Lord, art good, and ready to forgive,\nAnd abundant in lovingkindness unto all them that call upon thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.86.6",
      "edition_verse_id": "ASV1901:PSA.86.6",
      "verse": 6,
      "spans": [
        {
          "text": "Give ear, O Jehovah, unto my prayer;\nAnd hearken unto the voice of my supplications.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.86.7",
      "edition_verse_id": "ASV1901:PSA.86.7",
      "verse": 7,
      "spans": [
        {
          "text": "In the day of my trouble I will call upon thee;\nFor thou wilt answer me.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.86.8",
      "edition_verse_id": "ASV1901:PSA.86.8",
      "verse": 8,
      "spans": [
        {
          "text": "There is none like unto thee among the gods, O Lord;\nNeither ",
          "kind": "text"
        },
        {
          "text": "are there any works",
          "kind": "supplied"
        },
        {
          "text": " like unto thy works.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.86.9",
      "edition_verse_id": "ASV1901:PSA.86.9",
      "verse": 9,
      "spans": [
        {
          "text": "All nations whom thou hast made shall come and worship before thee, O Lord;\nAnd they shall glorify thy name.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.86.10",
      "edition_verse_id": "ASV1901:PSA.86.10",
      "verse": 10,
      "spans": [
        {
          "text": "For thou art great, and doest wondrous things:\nThou art God alone.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.86.11",
      "edition_verse_id": "ASV1901:PSA.86.11",
      "verse": 11,
      "spans": [
        {
          "text": "Teach me thy way, O Jehovah; I will walk in thy truth:\nUnite my heart to fear thy name.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.86.12",
      "edition_verse_id": "ASV1901:PSA.86.12",
      "verse": 12,
      "spans": [
        {
          "text": "I will praise thee, O Lord my God, with my whole heart;\nAnd I will glorify thy name for evermore.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.86.13",
      "edition_verse_id": "ASV1901:PSA.86.13",
      "verse": 13,
      "spans": [
        {
          "text": "For great is thy lovingkindness toward me;\nAnd thou hast delivered my soul from the lowest Sheol.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.86.14",
      "edition_verse_id": "ASV1901:PSA.86.14",
      "verse": 14,
      "spans": [
        {
          "text": "O God, the proud are risen up against me,\nAnd a company of violent men have sought after my soul,\nAnd have not set thee before them.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.86.15",
      "edition_verse_id": "ASV1901:PSA.86.15",
      "verse": 15,
      "spans": [
        {
          "text": "But thou, O Lord, art a God merciful and gracious,\nSlow to anger, and abundant in lovingkindness and truth.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.86.16",
      "edition_verse_id": "ASV1901:PSA.86.16",
      "verse": 16,
      "spans": [
        {
          "text": "Oh turn unto me, and have mercy upon me;\nGive thy strength unto thy servant,\nAnd save the son of thy handmaid.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.86.17",
      "edition_verse_id": "ASV1901:PSA.86.17",
      "verse": 17,
      "spans": [
        {
          "text": "Show me a token for good,\nThat they who hate me may see it, and be put to shame,\nBecause thou, Jehovah, hast helped me, and comforted me.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "A psalm of supplication and trust.",
      "before_verse": 1
    },
    {
      "style": "d",
      "text": "A Prayer of David.",
      "before_verse": 1
    }
  ]
}
