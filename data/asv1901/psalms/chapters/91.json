{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PSA",
  "chapter": 91,
  "verses": [
    {
      "id": "PSA.91.1",
      "edition_verse_id": "ASV1901:PSA.91.1",
      "verse": 1,
      "spans": [
        {
          "text": "He that dwelleth in the secret place of the Most HighShall abide under the shadow of the Almighty.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.91.2",
      "edition_verse_id": "ASV1901:PSA.91.2",
      "verse": 2,
      "spans": [
        {
          "text": "I will say of Jehovah, He is my refuge and my fortress;\nMy God, in whom I trust.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.91.3",
      "edition_verse_id": "ASV1901:PSA.91.3",
      "verse": 3,
      "spans": [
        {
          "text": "For he will deliver thee from the snare of the fowler,\nAnd from the deadly pestilence.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.91.4",
      "edition_verse_id": "ASV1901:PSA.91.4",
      "verse": 4,
      "spans": [
        {
          "text": "He will cover thee with his pinions,\nAnd under his wings shalt thou take refuge:\nHis truth is a shield and a buckler.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.91.5",
      "edition_verse_id": "ASV1901:PSA.91.5",
      "verse": 5,
      "spans": [
        {
          "text": "Thou shalt not be afraid for the terror by night,\nNor for the arrow that flieth by day;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.91.6",
      "edition_verse_id": "ASV1901:PSA.91.6",
      "verse": 6,
      "spans": [
        {
          "text": "For the pestilence that walketh in darkness,\nNor for the destruction that wasteth at noonday.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.91.7",
      "edition_verse_id": "ASV1901:PSA.91.7",
      "verse": 7,
      "spans": [
        {
          "text": "A thousand shall fall at thy side,\nAnd ten thousand at thy right hand;",
          "kind": "text"
        },
        {
          "text": "But",
          "kind": "supplied"
        },
        {
          "text": " it shall not come nigh thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.91.8",
      "edition_verse_id": "ASV1901:PSA.91.8",
      "verse": 8,
      "spans": [
        {
          "text": "Only with thine eyes shalt thou behold,\nAnd see the reward of the wicked.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.91.9",
      "edition_verse_id": "ASV1901:PSA.91.9",
      "verse": 9,
      "spans": [
        {
          "text": "For thou, O Jehovah, art my refuge!\nThou hast made the Most High thy habitation;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.91.10",
      "edition_verse_id": "ASV1901:PSA.91.10",
      "verse": 10,
      "spans": [
        {
          "text": "There shall no evil befall thee,\nNeither shall any plague come nigh thy tent.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.91.11",
      "edition_verse_id": "ASV1901:PSA.91.11",
      "verse": 11,
      "spans": [
        {
          "text": "For he will give his angels charge over thee,\nTo keep thee in all thy ways.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.91.12",
      "edition_verse_id": "ASV1901:PSA.91.12",
      "verse": 12,
      "spans": [
        {
          "text": "They shall bear thee up in their hands,\nLest thou dash thy foot against a stone.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.91.13",
      "edition_verse_id": "ASV1901:PSA.91.13",
      "verse": 13,
      "spans": [
        {
          "text": "Thou shalt tread upon the lion and adder:\nThe young lion and the serpent shalt thou trample under foot.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.91.14",
      "edition_verse_id": "ASV1901:PSA.91.14",
      "verse": 14,
      "spans": [
        {
          "text": "Because he hath set his love upon me, therefore will I deliver him:\nI will set him on high, because he hath known my name.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.91.15",
      "edition_verse_id": "ASV1901:PSA.91.15",
      "verse": 15,
      "spans": [
        {
          "text": "He shall call upon me, and I will answer him;\nI will be with him in trouble:\nI will deliver him, and honor him.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.91.16",
      "edition_verse_id": "ASV1901:PSA.91.16",
      "verse": 16,
      "spans": [
        {
          "text": "With long life will I satisfy him,\nAnd show him my salvation.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "Security of him who trusts in Jehovah.",
      "before_verse": 1
    }
  ]
}
