{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PSA",
  "chapter": 124,
  "verses": [
    {
      "id": "PSA.124.1",
      "edition_verse_id": "ASV1901:PSA.124.1",
      "verse": 1,
      "spans": [
        {
          "text": "If it had not been Jehovah who was on our side,\nLet Israel now say,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.124.2",
      "edition_verse_id": "ASV1901:PSA.124.2",
      "verse": 2,
      "spans": [
        {
          "text": "If it had not been Jehovah who was on our side,\nWhen men rose up against us;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.124.3",
      "edition_verse_id": "ASV1901:PSA.124.3",
      "verse": 3,
      "spans": [
        {
          "text": "Then they had swallowed us up alive,\nWhen their wrath was kindled against us:",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.124.4",
      "edition_verse_id": "ASV1901:PSA.124.4",
      "verse": 4,
      "spans": [
        {
          "text": "Then the waters had overwhelmed us,\nThe stream had gone over our soul;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.124.5",
      "edition_verse_id": "ASV1901:PSA.124.5",
      "verse": 5,
      "spans": [
        {
          "text": "Then the proud waters had gone over our soul.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.124.6",
      "edition_verse_id": "ASV1901:PSA.124.6",
      "verse": 6,
      "spans": [
        {
          "text": "Blessed be Jehovah,\nWho hath not given us as a prey to their teeth.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.124.7",
      "edition_verse_id": "ASV1901:PSA.124.7",
      "verse": 7,
      "spans": [
        {
          "text": "Our soul is escaped as a bird out of the snare of the fowlers:\nThe snare is broken, and we are escaped.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.124.8",
      "edition_verse_id": "ASV1901:PSA.124.8",
      "verse": 8,
      "spans": [
        {
          "text": "Our help is in the name of Jehovah,\nWho made heaven and earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "Praise for rescue from enemies.",
      "before_verse": 1
    },
    {
      "style": "d",
      "text": "A Song of Ascents; of David.",
      "before_verse": 1
    }
  ]
}
