{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PSA",
  "chapter": 47,
  "verses": [
    {
      "id": "PSA.47.1",
      "edition_verse_id": "ASV1901:PSA.47.1",
      "verse": 1,
      "spans": [
        {
          "text": "Oh clap your hands, all ye peoples;\nShout unto God with the voice of triumph.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.47.2",
      "edition_verse_id": "ASV1901:PSA.47.2",
      "verse": 2,
      "spans": [
        {
          "text": "For Jehovah Most High is terrible;\nHe is a great King over all the earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.47.3",
      "edition_verse_id": "ASV1901:PSA.47.3",
      "verse": 3,
      "spans": [
        {
          "text": "He subdueth peoples under us,\nAnd nations under our feet.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.47.4",
      "edition_verse_id": "ASV1901:PSA.47.4",
      "verse": 4,
      "spans": [
        {
          "text": "He chooseth our inheritance for us,\nThe glory of Jacob whom he loved. [Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.47.5",
      "edition_verse_id": "ASV1901:PSA.47.5",
      "verse": 5,
      "spans": [
        {
          "text": "God is gone up with a shout,\nJehovah with the sound of a trumpet.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.47.6",
      "edition_verse_id": "ASV1901:PSA.47.6",
      "verse": 6,
      "spans": [
        {
          "text": "Sing praises to God, sing praises:\nSing praises unto our King, sing praises.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.47.7",
      "edition_verse_id": "ASV1901:PSA.47.7",
      "verse": 7,
      "spans": [
        {
          "text": "For God is the King of all the earth:\nSing ye praises with understanding.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.47.8",
      "edition_verse_id": "ASV1901:PSA.47.8",
      "verse": 8,
      "spans": [
        {
          "text": "God reigneth over the nations:\nGod sitteth upon his holy throne.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.47.9",
      "edition_verse_id": "ASV1901:PSA.47.9",
      "verse": 9,
      "spans": [
        {
          "text": "The princes of the peoples are gathered together",
          "kind": "text"
        },
        {
          "text": "To be",
          "kind": "supplied"
        },
        {
          "text": " the people of the God of Abraham;\nFor the shields of the earth belong unto God:\nHe is greatly exalted.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "God the King of the Earth.",
      "before_verse": 1
    },
    {
      "style": "d",
      "text": "For the Chief Musician. A Psalm of the sons of Korah.",
      "before_verse": 1
    }
  ]
}
