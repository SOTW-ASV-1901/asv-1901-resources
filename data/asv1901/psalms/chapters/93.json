  "book_code": "PSA",
  "chapter": 93,
  "verses": [
    {
      "id": "PSA.93.1",
      "edition_verse_id": "ASV1901:PSA.93.1",
      "verse": 1,
      "spans": [
        {
          "text": "Jehovah reigneth; he is clothed with majesty;\nJehovah is clothed with strength; he hath girded himself therewith:\nThe world also is established, that it cannot be moved.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.93.2",
      "edition_verse_id": "ASV1901:PSA.93.2",
      "verse": 2,
      "spans": [
        {
          "text": "Thy throne is established of old:\nThou art from everlasting.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.93.3",
      "edition_verse_id": "ASV1901:PSA.93.3",
      "verse": 3,
      "spans": [
        {
          "text": "The floods have lifted up, O Jehovah,\nThe floods have lifted up their voice;\nThe floods lift up their waves.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.93.4",
      "edition_verse_id": "ASV1901:PSA.93.4",
      "verse": 4,
      "spans": [
        {
          "text": "Above the voices of many waters,\nThe mighty breakers of the sea,\nJehovah on high is mighty.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.93.5",
      "edition_verse_id": "ASV1901:PSA.93.5",
      "verse": 5,
      "spans": [
        {
          "text": "Thy testimonies are very sure:\nHoliness becometh thy house,\nO Jehovah, for evermore.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "The majesty of Jehovah.",
      "before_verse": 1
    }
  ]
}
