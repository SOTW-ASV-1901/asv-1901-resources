      "edition_verse_id": "ASV1901:PSA.4.2",
      "verse": 2,
      "spans": [
        {
          "text": "O ye sons of men, how long shall my glory be turned into dishonor?",
          "kind": "text"
        },
        {
          "text": "How long",
