{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PSA",
  "chapter": 145,
  "verses": [
    {
      "id": "PSA.145.1",
      "edition_verse_id": "ASV1901:PSA.145.1",
      "verse": 1,
      "spans": [
        {
          "text": "I will extol thee, my God, O King;\nAnd I will bless thy name for ever and ever.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.2",
      "edition_verse_id": "ASV1901:PSA.145.2",
      "verse": 2,
      "spans": [
        {
          "text": "Every day will I bless thee;\nAnd I will praise thy name for ever and ever.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.3",
      "edition_verse_id": "ASV1901:PSA.145.3",
      "verse": 3,
      "spans": [
        {
          "text": "Great is Jehovah, and greatly to be praised;\nAnd his greatness is unsearchable.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.4",
      "edition_verse_id": "ASV1901:PSA.145.4",
      "verse": 4,
      "spans": [
        {
          "text": "One generation shall laud thy works to another,\nAnd shall declare thy mighty acts.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.5",
      "edition_verse_id": "ASV1901:PSA.145.5",
      "verse": 5,
      "spans": [
        {
          "text": "Of the glorious majesty of thine honor,\nAnd of thy wondrous works, will I meditate.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.6",
      "edition_verse_id": "ASV1901:PSA.145.6",
      "verse": 6,
      "spans": [
        {
          "text": "And men shall speak of the might of thy terrible acts;\nAnd I will declare thy greatness.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.7",
      "edition_verse_id": "ASV1901:PSA.145.7",
      "verse": 7,
      "spans": [
        {
          "text": "They shall utter the memory of thy great goodness,\nAnd shall sing of thy righteousness.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.8",
      "edition_verse_id": "ASV1901:PSA.145.8",
      "verse": 8,
      "spans": [
        {
          "text": "Jehovah is gracious, and merciful;\nSlow to anger, and of great lovingkindness.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.9",
      "edition_verse_id": "ASV1901:PSA.145.9",
      "verse": 9,
      "spans": [
        {
          "text": "Jehovah is good to all;\nAnd his tender mercies are over all his works.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.10",
      "edition_verse_id": "ASV1901:PSA.145.10",
      "verse": 10,
      "spans": [
        {
          "text": "All thy works shall give thanks unto thee, O Jehovah;\nAnd thy saints shall bless thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.11",
      "edition_verse_id": "ASV1901:PSA.145.11",
      "verse": 11,
      "spans": [
        {
          "text": "They shall speak of the glory of thy kingdom,\nAnd talk of thy power;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.12",
      "edition_verse_id": "ASV1901:PSA.145.12",
      "verse": 12,
      "spans": [
        {
          "text": "To make known to the sons of men his mighty acts,\nAnd the glory of the majesty of his kingdom.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.13",
      "edition_verse_id": "ASV1901:PSA.145.13",
      "verse": 13,
      "spans": [
        {
          "text": "Thy kingdom is an everlasting kingdom,\nAnd thy dominion ",
          "kind": "text"
        },
        {
          "text": "endureth",
          "kind": "supplied"
        },
        {
          "text": " throughout all generations.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.14",
      "edition_verse_id": "ASV1901:PSA.145.14",
      "verse": 14,
      "spans": [
        {
          "text": "Jehovah upholdeth all that fall,\nAnd raiseth up all those that are bowed down.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.15",
      "edition_verse_id": "ASV1901:PSA.145.15",
      "verse": 15,
      "spans": [
        {
          "text": "The eyes of all wait for thee;\nAnd thou givest them their food in due season.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.16",
      "edition_verse_id": "ASV1901:PSA.145.16",
      "verse": 16,
      "spans": [
        {
          "text": "Thou openest thy hand,\nAnd satisfiest the desire of every living thing.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.17",
      "edition_verse_id": "ASV1901:PSA.145.17",
      "verse": 17,
      "spans": [
        {
          "text": "Jehovah is righteous in all his ways,\nAnd gracious in all his works.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.18",
      "edition_verse_id": "ASV1901:PSA.145.18",
      "verse": 18,
      "spans": [
        {
          "text": "Jehovah is nigh unto all them that call upon him,\nTo all that call upon him in truth.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.19",
      "edition_verse_id": "ASV1901:PSA.145.19",
      "verse": 19,
      "spans": [
        {
          "text": "He will fulfil the desire of them that fear him;\nHe also will hear their cry and will save them.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.20",
      "edition_verse_id": "ASV1901:PSA.145.20",
      "verse": 20,
      "spans": [
        {
          "text": "Jehovah preserveth all them that love him;\nBut all the wicked will he destroy.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.21",
      "edition_verse_id": "ASV1901:PSA.145.21",
      "verse": 21,
      "spans": [
        {
          "text": "My mouth shall speak the praise of Jehovah;\nAnd let all flesh bless his holy name for ever and ever.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "Jehovah extolled for his goodness and power.",
      "before_verse": 1
    },
    {
      "style": "d",
      "text": "A Psalm of praise; of David.",
      "before_verse": 1
    }
  ]
}
