{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PSA",
  "chapter": 61,
  "verses": [
    {
      "id": "PSA.61.1",
      "edition_verse_id": "ASV1901:PSA.61.1",
      "verse": 1,
      "spans": [
        {
          "text": "Hear my cry, O God;\nAttend unto my prayer.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.61.2",
      "edition_verse_id": "ASV1901:PSA.61.2",
      "verse": 2,
      "spans": [
        {
          "text": "From the end of the earth will I call unto thee, when my heart is overwhelmed:\nLead me to the rock that is higher than I.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.61.3",
      "edition_verse_id": "ASV1901:PSA.61.3",
      "verse": 3,
      "spans": [
        {
          "text": "For thou hast been a refuge for me,\nA strong tower from the enemy.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.61.4",
      "edition_verse_id": "ASV1901:PSA.61.4",
      "verse": 4,
      "spans": [
        {
          "text": "I will dwell in thy tabernacle for ever:\nI will take refuge in the covert of thy wings. [Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.61.5",
      "edition_verse_id": "ASV1901:PSA.61.5",
      "verse": 5,
      "spans": [
        {
          "text": "For thou, O God, hast heard my vows:\nThou hast given ",
          "kind": "text"
        },
        {
          "text": "me",
          "kind": "supplied"
        },
        {
          "text": " the heritage of those that fear thy name.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.61.6",
      "edition_verse_id": "ASV1901:PSA.61.6",
      "verse": 6,
      "spans": [
        {
          "text": "Thou wilt prolong the king’s life;\nHis years shall be as many generations.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.61.7",
      "edition_verse_id": "ASV1901:PSA.61.7",
      "verse": 7,
      "spans": [
        {
          "text": "He shall abide before God for ever:\nOh prepare lovingkindness and truth, that they may preserve him.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.61.8",
      "edition_verse_id": "ASV1901:PSA.61.8",
      "verse": 8,
      "spans": [
        {
          "text": "So will I sing praise unto thy name for ever,\nThat I may daily perform my vows.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "Confidence in God’s protection.",
      "before_verse": 1
    },
    {
      "style": "d",
      "text": "For the Chief Musician; on a stringed instrument. A Psalm of David.",
      "before_verse": 1
    }
  ]
}
