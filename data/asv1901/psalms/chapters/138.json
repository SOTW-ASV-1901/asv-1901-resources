{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PSA",
  "chapter": 138,
  "verses": [
    {
      "id": "PSA.138.1",
      "edition_verse_id": "ASV1901:PSA.138.1",
      "verse": 1,
      "spans": [
        {
          "text": "I will give thee thanks with my whole heart:\nBefore the gods will I sing praises unto thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.138.2",
      "edition_verse_id": "ASV1901:PSA.138.2",
      "verse": 2,
      "spans": [
        {
          "text": "I will worship toward thy holy temple,\nAnd give thanks unto thy name for thy lovingkindness and for thy truth:\nFor thou hast magnified thy word above all thy name.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.138.3",
      "edition_verse_id": "ASV1901:PSA.138.3",
      "verse": 3,
      "spans": [
        {
          "text": "In the day that I called thou answeredst me,\nThou didst encourage me with strength in my soul.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.138.4",
      "edition_verse_id": "ASV1901:PSA.138.4",
      "verse": 4,
      "spans": [
        {
          "text": "All the kings of the earth shall give thee thanks, O Jehovah,\nFor they have heard the words of thy mouth.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.138.5",
      "edition_verse_id": "ASV1901:PSA.138.5",
      "verse": 5,
      "spans": [
        {
          "text": "Yea, they shall sing of the ways of Jehovah;\nFor great is the glory of Jehovah.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.138.6",
      "edition_verse_id": "ASV1901:PSA.138.6",
      "verse": 6,
      "spans": [
        {
          "text": "For though Jehovah is high, yet hath he respect unto the lowly;\nBut the haughty he knoweth from afar.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.138.7",
      "edition_verse_id": "ASV1901:PSA.138.7",
      "verse": 7,
      "spans": [
        {
          "text": "Though I walk in the midst of trouble, thou wilt revive me;\nThou wilt stretch forth thy hand against the wrath of mine enemies,\nAnd thy right hand will save me.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.138.8",
      "edition_verse_id": "ASV1901:PSA.138.8",
      "verse": 8,
      "spans": [
        {
          "text": "Jehovah will perfect that which concerneth me:\nThy lovingkindness, O Jehovah, ",
          "kind": "text"
        },
        {
          "text": "endureth",
          "kind": "supplied"
        },
        {
          "text": " for ever;\nForsake not the works of thine own hands.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "Thanksgiving for Jehovah’s favor.",
      "before_verse": 1
    },
    {
      "style": "d",
      "text": "A Psalm of David.",
      "before_verse": 1
    }
  ]
}
