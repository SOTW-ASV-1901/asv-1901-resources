      "verse": 1,
      "spans": [
        {
          "text": "Make a joyful noise unto Jehovah, all ye lands.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.100.2",
      "edition_verse_id": "ASV1901:PSA.100.2",
      "verse": 2,
      "spans": [
        {
          "text": "Serve Jehovah with gladness:\nCome before his presence with singing.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.100.3",
      "edition_verse_id": "ASV1901:PSA.100.3",
      "verse": 3,
      "spans": [
        {
          "text": "Know ye that Jehovah, he is God:\nIt is he that hath made us, and we are his;\nWe are his people, and the sheep of his pasture.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.100.4",
      "edition_verse_id": "ASV1901:PSA.100.4",
      "verse": 4,
      "spans": [
        {
          "text": "Enter into his gates with thanksgiving,\nAnd into his courts with praise:\nGive thanks unto him, and bless his name.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.100.5",
      "edition_verse_id": "ASV1901:PSA.100.5",
      "verse": 5,
      "spans": [
        {
          "text": "For Jehovah is good; his lovingkindness ",
          "kind": "text"
        },
        {
          "text": "endureth",
          "kind": "supplied"
        },
        {
          "text": " for ever,\nAnd his faithfulness unto all generations.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
