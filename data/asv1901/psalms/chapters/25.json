{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PSA",
  "chapter": 25,
  "verses": [
    {
      "id": "PSA.25.1",
      "edition_verse_id": "ASV1901:PSA.25.1",
      "verse": 1,
      "spans": [
        {
          "text": "Unto thee, O Jehovah, do I lift up my soul.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.2",
      "edition_verse_id": "ASV1901:PSA.25.2",
      "verse": 2,
      "spans": [
        {
          "text": "O my God, in thee have I trusted,\nLet me not be put to shame;\nLet not mine enemies triumph over me.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.3",
      "edition_verse_id": "ASV1901:PSA.25.3",
      "verse": 3,
      "spans": [
        {
          "text": "Yea, none that wait for thee shall be put to shame:\nThey shall be put to shame that deal treacherously without cause.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.4",
      "edition_verse_id": "ASV1901:PSA.25.4",
      "verse": 4,
      "spans": [
        {
          "text": "Show me thy ways, O Jehovah;\nTeach me thy paths.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.5",
      "edition_verse_id": "ASV1901:PSA.25.5",
      "verse": 5,
      "spans": [
        {
          "text": "Guide me in thy truth, and teach me;\nFor thou art the God of my salvation;\nFor thee do I wait all the day.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.6",
      "edition_verse_id": "ASV1901:PSA.25.6",
      "verse": 6,
      "spans": [
        {
          "text": "Remember, O Jehovah, thy tender mercies and thy lovingkindness;\nFor they have been ever of old.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.7",
      "edition_verse_id": "ASV1901:PSA.25.7",
      "verse": 7,
      "spans": [
        {
          "text": "Remember not the sins of my youth, nor my transgressions:\nAccording to thy lovingkindness remember thou me,\nFor thy goodness’ sake, O Jehovah.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.8",
      "edition_verse_id": "ASV1901:PSA.25.8",
      "verse": 8,
      "spans": [
        {
          "text": "Good and upright is Jehovah:\nTherefore will he instruct sinners in the way.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.9",
      "edition_verse_id": "ASV1901:PSA.25.9",
      "verse": 9,
      "spans": [
        {
          "text": "The meek will he guide in justice;\nAnd the meek will he teach his way.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.10",
      "edition_verse_id": "ASV1901:PSA.25.10",
      "verse": 10,
      "spans": [
        {
          "text": "All the paths of Jehovah are lovingkindness and truth\nUnto such as keep his covenant and his testimonies.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.11",
      "edition_verse_id": "ASV1901:PSA.25.11",
      "verse": 11,
      "spans": [
        {
          "text": "For thy name’s sake, O Jehovah,\nPardon mine iniquity, for it is great.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.12",
      "edition_verse_id": "ASV1901:PSA.25.12",
      "verse": 12,
      "spans": [
        {
          "text": "What man is he that feareth Jehovah?\nHim shall he instruct in the way that he shall choose.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.13",
      "edition_verse_id": "ASV1901:PSA.25.13",
      "verse": 13,
      "spans": [
        {
          "text": "His soul shall dwell at ease;\nAnd his seed shall inherit the land.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.14",
      "edition_verse_id": "ASV1901:PSA.25.14",
      "verse": 14,
      "spans": [
        {
          "text": "The friendship of Jehovah is with them that fear him;And he will show them his covenant.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.15",
      "edition_verse_id": "ASV1901:PSA.25.15",
      "verse": 15,
      "spans": [
        {
          "text": "Mine eyes are ever toward Jehovah;\nFor he will pluck my feet out of the net.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.16",
      "edition_verse_id": "ASV1901:PSA.25.16",
      "verse": 16,
      "spans": [
        {
          "text": "Turn thee unto me, and have mercy upon me;\nFor I am desolate and afflicted.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.17",
      "edition_verse_id": "ASV1901:PSA.25.17",
      "verse": 17,
      "spans": [
        {
          "text": "The troubles of my heart are enlarged:\nOh bring thou me out of my distresses.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.18",
      "edition_verse_id": "ASV1901:PSA.25.18",
      "verse": 18,
      "spans": [
        {
          "text": "Consider mine affliction and my travail;\nAnd forgive all my sins.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.19",
      "edition_verse_id": "ASV1901:PSA.25.19",
      "verse": 19,
      "spans": [
        {
          "text": "Consider mine enemies, for they are many;\nAnd they hate me with cruel hatred.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.20",
      "edition_verse_id": "ASV1901:PSA.25.20",
      "verse": 20,
      "spans": [
        {
          "text": "Oh keep my soul, and deliver me:\nLet me not be put to shame, for I take refuge in thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.21",
      "edition_verse_id": "ASV1901:PSA.25.21",
      "verse": 21,
      "spans": [
        {
          "text": "Let integrity and uprightness preserve me,\nFor I wait for thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.22",
      "edition_verse_id": "ASV1901:PSA.25.22",
      "verse": 22,
      "spans": [
        {
          "text": "Redeem Israel, O God,\nOut of all his troubles.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "Prayer for protection, guidance, and pardon.",
      "before_verse": 1
    },
    {
      "style": "d",
      "text": "A Psalm of David.",
      "before_verse": 1
    }
  ]
}
