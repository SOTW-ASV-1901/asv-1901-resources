      "verse": 1,
      "spans": [
        {
          "text": "Be merciful unto me, O God, be merciful unto me;\nFor my soul taketh refuge in thee:\nYea, in the shadow of thy wings will I take refuge,\nUntil ",
          "kind": "text"
        },
        {
          "text": "these",
          "kind": "supplied"
        },
        {
          "text": " calamities be overpast.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.57.2",
      "edition_verse_id": "ASV1901:PSA.57.2",
      "verse": 2,
      "spans": [
        {
          "text": "I will cry unto God Most High,\nUnto God that performeth ",
          "kind": "text"
        },
        {
          "text": "all things",
          "kind": "supplied"
        },
        {
          "text": " for me.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
