{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PSA",
  "chapter": 144,
  "verses": [
    {
      "id": "PSA.144.1",
      "edition_verse_id": "ASV1901:PSA.144.1",
      "verse": 1,
      "spans": [
        {
          "text": "Blessed be Jehovah my rock,\nWho teacheth my hands to war,",
          "kind": "text"
        },
        {
          "text": "And",
          "kind": "supplied"
        },
        {
          "text": " my fingers to fight:",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.144.2",
      "edition_verse_id": "ASV1901:PSA.144.2",
      "verse": 2,
      "spans": [
        {
          "text": "My lovingkindness, and my fortress,\nMy high tower, and my deliverer;\nMy shield, and he in whom I take refuge;\nWho subdueth my people under me.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.144.3",
      "edition_verse_id": "ASV1901:PSA.144.3",
      "verse": 3,
      "spans": [
        {
          "text": "Jehovah, what is man, that thou takest knowledge of him?\nOr the son of man, that thou makest account of him?",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.144.4",
      "edition_verse_id": "ASV1901:PSA.144.4",
      "verse": 4,
      "spans": [
        {
          "text": "Man is like to vanity:\nHis days are as a shadow that passeth away.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.144.5",
      "edition_verse_id": "ASV1901:PSA.144.5",
      "verse": 5,
      "spans": [
        {
          "text": "Bow thy heavens, O Jehovah, and come down:\nTouch the mountains, and they shall smoke.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.144.6",
      "edition_verse_id": "ASV1901:PSA.144.6",
      "verse": 6,
      "spans": [
        {
          "text": "Cast forth lightning, and scatter them;\nSend out thine arrows, and discomfit them.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.144.7",
      "edition_verse_id": "ASV1901:PSA.144.7",
      "verse": 7,
      "spans": [
        {
          "text": "Stretch forth thy hand from above;\nRescue me, and deliver me out of great waters,\nOut of the hand of aliens;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.144.8",
      "edition_verse_id": "ASV1901:PSA.144.8",
      "verse": 8,
      "spans": [
        {
          "text": "Whose mouth speaketh deceit,\nAnd whose right hand is a right hand of falsehood.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.144.9",
      "edition_verse_id": "ASV1901:PSA.144.9",
      "verse": 9,
      "spans": [
        {
          "text": "I will sing a new song unto thee, O God:\nUpon a psaltery of ten strings will I sing praises unto thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.144.10",
      "edition_verse_id": "ASV1901:PSA.144.10",
      "verse": 10,
      "spans": [
        {
          "text": "Thou art he that giveth salvation unto kings;\nWho rescueth David his servant from the hurtful sword.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.144.11",
      "edition_verse_id": "ASV1901:PSA.144.11",
      "verse": 11,
      "spans": [
        {
          "text": "Rescue me, and deliver me out of the hand of aliens,\nWhose mouth speaketh deceit,\nAnd whose right hand is a right hand of falsehood.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.144.12",
      "edition_verse_id": "ASV1901:PSA.144.12",
      "verse": 12,
      "spans": [
        {
          "text": "When our sons shall be as plants grown up in their youth,\nAnd our daughters as corner-stones hewn after the fashion of a palace;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.144.13",
      "edition_verse_id": "ASV1901:PSA.144.13",
      "verse": 13,
      "spans": [
        {
          "text": "When",
          "kind": "supplied"
        },
        {
          "text": " our garners are full, affording all manner of store,",
          "kind": "text"
        },
        {
          "text": "And",
          "kind": "supplied"
        },
        {
          "text": " our sheep bring forth thousands and ten thousands in our fields;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.144.14",
      "edition_verse_id": "ASV1901:PSA.144.14",
      "verse": 14,
      "spans": [
        {
          "text": "When",
          "kind": "supplied"
        },
        {
          "text": " our oxen are well laden;",
          "kind": "text"
        },
        {
          "text": "When there is",
          "kind": "supplied"
        },
        {
          "text": " no breaking in, and no going forth,\nAnd no outcry in our streets:",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.144.15",
      "edition_verse_id": "ASV1901:PSA.144.15",
      "verse": 15,
      "spans": [
        {
          "text": "Happy is the people that is in such a case;",
          "kind": "text"
        },
        {
          "text": "Yea",
          "kind": "supplied"
        },
        {
          "text": ", happy is the people whose God is Jehovah.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "Prayer for rescue. A happy people described.",
      "before_verse": 1
    },
    {
      "style": "d",
      "text": "A Psalm of David.",
      "before_verse": 1
    }
  ]
}
