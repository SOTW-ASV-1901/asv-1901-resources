{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PSA",
  "chapter": 147,
  "verses": [
    {
      "id": "PSA.147.1",
      "edition_verse_id": "ASV1901:PSA.147.1",
      "verse": 1,
      "spans": [
        {
          "text": "Praise ye Jehovah;For it is good to sing praises unto our God;\nFor it is pleasant, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " praise is comely.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.2",
      "edition_verse_id": "ASV1901:PSA.147.2",
      "verse": 2,
      "spans": [
        {
          "text": "Jehovah doth build up Jerusalem;\nHe gathereth together the outcasts of Israel.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.3",
      "edition_verse_id": "ASV1901:PSA.147.3",
      "verse": 3,
      "spans": [
        {
          "text": "He healeth the broken in heart,\nAnd bindeth up their wounds.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.4",
      "edition_verse_id": "ASV1901:PSA.147.4",
      "verse": 4,
      "spans": [
        {
          "text": "He counteth the number of the stars;\nHe calleth them all by ",
          "kind": "text"
        },
        {
          "text": "their",
          "kind": "supplied"
        },
        {
          "text": " names.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.5",
      "edition_verse_id": "ASV1901:PSA.147.5",
      "verse": 5,
      "spans": [
        {
          "text": "Great is our Lord, and mighty in power;\nHis understanding is infinite.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.6",
      "edition_verse_id": "ASV1901:PSA.147.6",
      "verse": 6,
      "spans": [
        {
          "text": "Jehovah upholdeth the meek:\nHe bringeth the wicked down to the ground.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.7",
      "edition_verse_id": "ASV1901:PSA.147.7",
      "verse": 7,
      "spans": [
        {
          "text": "Sing unto Jehovah with thanksgiving;\nSing praises upon the harp unto our God,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.8",
      "edition_verse_id": "ASV1901:PSA.147.8",
      "verse": 8,
      "spans": [
        {
          "text": "Who covereth the heavens with clouds,\nWho prepareth rain for the earth,\nWho maketh grass to grow upon the mountains.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.9",
      "edition_verse_id": "ASV1901:PSA.147.9",
      "verse": 9,
      "spans": [
        {
          "text": "He giveth to the beast his food,",
          "kind": "text"
        },
        {
          "text": "And",
          "kind": "supplied"
        },
        {
          "text": " to the young ravens which cry.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.10",
      "edition_verse_id": "ASV1901:PSA.147.10",
      "verse": 10,
      "spans": [
        {
          "text": "He delighteth not in the strength of the horse:\nHe taketh no pleasure in the legs of a man.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.11",
      "edition_verse_id": "ASV1901:PSA.147.11",
      "verse": 11,
      "spans": [
        {
          "text": "Jehovah taketh pleasure in them that fear him,\nIn those that hope in his lovingkindness.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.12",
      "edition_verse_id": "ASV1901:PSA.147.12",
      "verse": 12,
      "spans": [
        {
          "text": "Praise Jehovah, O Jerusalem;\nPraise thy God, O Zion.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.13",
      "edition_verse_id": "ASV1901:PSA.147.13",
      "verse": 13,
      "spans": [
        {
          "text": "For he hath strengthened the bars of thy gates;\nHe hath blessed thy children within thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.14",
      "edition_verse_id": "ASV1901:PSA.147.14",
      "verse": 14,
      "spans": [
        {
          "text": "He maketh peace in thy borders;\nHe filleth thee with the finest of the wheat.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.15",
      "edition_verse_id": "ASV1901:PSA.147.15",
      "verse": 15,
      "spans": [
        {
          "text": "He sendeth out his commandment upon earth;\nHis word runneth very swiftly.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.16",
      "edition_verse_id": "ASV1901:PSA.147.16",
      "verse": 16,
      "spans": [
        {
          "text": "He giveth snow like wool;\nHe scattereth the hoar-frost like ashes.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.17",
      "edition_verse_id": "ASV1901:PSA.147.17",
      "verse": 17,
      "spans": [
        {
          "text": "He casteth forth his ice like morsels:\nWho can stand before his cold?",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.18",
      "edition_verse_id": "ASV1901:PSA.147.18",
      "verse": 18,
      "spans": [
        {
          "text": "He sendeth out his word, and melteth them:\nHe causeth his wind to blow, and the waters flow.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.19",
      "edition_verse_id": "ASV1901:PSA.147.19",
      "verse": 19,
      "spans": [
        {
          "text": "He showeth his word unto Jacob,\nHis statutes and his ordinances unto Israel.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.147.20",
      "edition_verse_id": "ASV1901:PSA.147.20",
      "verse": 20,
      "spans": [
        {
          "text": "He hath not dealt so with any nation;\nAnd as for his ordinances, they have not known them.Praise ye Jehovah.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "Praise for Jerusalem’s restoration and prosperity.",
      "before_verse": 1
    }
  ]
}
