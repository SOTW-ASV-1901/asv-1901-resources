  "chapter": 128,
  "verses": [
    {
      "id": "PSA.128.1",
      "edition_verse_id": "ASV1901:PSA.128.1",
      "verse": 1,
      "spans": [
        {
          "text": "Blessed is every one that feareth Jehovah,\nThat walketh in his ways.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.128.2",
      "edition_verse_id": "ASV1901:PSA.128.2",
      "verse": 2,
      "spans": [
        {
          "text": "For thou shalt eat the labor of thy hands:\nHappy shalt thou be, and it shall be well with thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.128.3",
      "edition_verse_id": "ASV1901:PSA.128.3",
      "verse": 3,
      "spans": [
        {
          "text": "Thy wife shall be as a fruitful vine,\nIn the innermost parts of thy house;\nThy children like olive plants,\nRound about thy table.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.128.4",
      "edition_verse_id": "ASV1901:PSA.128.4",
      "verse": 4,
      "spans": [
        {
          "text": "Behold, thus shall the man be blessed\nThat feareth Jehovah.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.128.5",
      "edition_verse_id": "ASV1901:PSA.128.5",
      "verse": 5,
      "spans": [
        {
          "text": "Jehovah bless thee out of Zion:\nAnd see thou the good of Jerusalem all the days of thy life.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.128.6",
      "edition_verse_id": "ASV1901:PSA.128.6",
      "verse": 6,
      "spans": [
        {
          "text": "Yea, see thou thy children’s children.Peace be upon Israel.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "Blessedness of the fear of Jehovah.",
      "before_verse": 1
    },
