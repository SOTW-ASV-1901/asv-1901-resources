  "book_code": "PSA",
  "chapter": 23,
  "verses": [
    {
      "id": "PSA.23.1",
      "edition_verse_id": "ASV1901:PSA.23.1",
      "verse": 1,
      "spans": [
        {
          "text": "Jehovah is my shepherd; I shall not want.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.23.2",
      "edition_verse_id": "ASV1901:PSA.23.2",
      "verse": 2,
      "spans": [
        {
          "text": "He maketh me to lie down in green pastures;\nHe leadeth me beside still waters.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.23.3",
      "edition_verse_id": "ASV1901:PSA.23.3",
      "verse": 3,
      "spans": [
        {
          "text": "He restoreth my soul:\nHe guideth me in the paths of righteousness for his name’s sake.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.23.4",
      "edition_verse_id": "ASV1901:PSA.23.4",
      "verse": 4,
      "spans": [
        {
          "text": "Yea, though I walk through the valley of the shadow of death,\nI will fear no evil; for thou art with me;\nThy rod and thy staff, they comfort me.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.23.5",
      "edition_verse_id": "ASV1901:PSA.23.5",
      "verse": 5,
      "spans": [
        {
          "text": "Thou preparest a table before me in the presence of mine enemies:\nThou hast anointed my head with oil;\nMy cup runneth over.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.23.6",
      "edition_verse_id": "ASV1901:PSA.23.6",
      "verse": 6,
      "spans": [
        {
          "text": "Surely goodness and lovingkindness shall follow me all the days of my life;\nAnd I shall dwell in the house of Jehovah for ever.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "Jehovah the psalmist’s shepherd.",
      "before_verse": 1
    },
    {
      "style": "d",
      "text": "A Psalm of David.",
      "before_verse": 1
    }
  ]
