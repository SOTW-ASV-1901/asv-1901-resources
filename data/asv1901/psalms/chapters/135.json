{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PSA",
  "chapter": 135,
  "verses": [
    {
      "id": "PSA.135.1",
      "edition_verse_id": "ASV1901:PSA.135.1",
      "verse": 1,
      "spans": [
        {
          "text": "Praise ye Jehovah.\nPraise ye the name of Jehovah;\nPraise ",
          "kind": "text"
        },
        {
          "text": "him",
          "kind": "supplied"
        },
        {
          "text": ", O ye servants of Jehovah,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.2",
      "edition_verse_id": "ASV1901:PSA.135.2",
      "verse": 2,
      "spans": [
        {
          "text": "Ye that stand in the house of Jehovah,\nIn the courts of the house of our God.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.3",
      "edition_verse_id": "ASV1901:PSA.135.3",
      "verse": 3,
      "spans": [
        {
          "text": "Praise ye Jehovah; for Jehovah is good:\nSing praises unto his name; for it is pleasant.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.4",
      "edition_verse_id": "ASV1901:PSA.135.4",
      "verse": 4,
      "spans": [
        {
          "text": "For Jehovah hath chosen Jacob unto himself,",
          "kind": "text"
        },
        {
          "text": "And",
          "kind": "supplied"
        },
        {
          "text": " Israel for his own possession.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.5",
      "edition_verse_id": "ASV1901:PSA.135.5",
      "verse": 5,
      "spans": [
        {
          "text": "For I know that Jehovah is great,\nAnd that our Lord is above all gods.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.6",
      "edition_verse_id": "ASV1901:PSA.135.6",
      "verse": 6,
      "spans": [
        {
          "text": "Whatsoever Jehovah pleased, that hath he done,\nIn heaven and in earth, in the seas and in all deeps;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.7",
      "edition_verse_id": "ASV1901:PSA.135.7",
      "verse": 7,
      "spans": [
        {
          "text": "Who causeth the vapors to ascend from the ends of the earth;\nWho maketh lightnings for the rain;\nWho bringeth forth the wind out of his treasuries;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.8",
      "edition_verse_id": "ASV1901:PSA.135.8",
      "verse": 8,
      "spans": [
        {
          "text": "Who smote the first-born of Egypt,\nBoth of man and beast;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.9",
      "edition_verse_id": "ASV1901:PSA.135.9",
      "verse": 9,
      "spans": [
        {
          "text": "Who sent signs and wonders into the midst of thee, O Egypt,\nUpon Pharaoh, and upon all his servants;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.10",
      "edition_verse_id": "ASV1901:PSA.135.10",
      "verse": 10,
      "spans": [
        {
          "text": "Who smote many nations,\nAnd slew mighty kings,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.11",
      "edition_verse_id": "ASV1901:PSA.135.11",
      "verse": 11,
      "spans": [
        {
          "text": "Sihon king of the Amorites,\nAnd Og king of Bashan,\nAnd all the kingdoms of Canaan,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.12",
      "edition_verse_id": "ASV1901:PSA.135.12",
      "verse": 12,
      "spans": [
        {
          "text": "And gave their land for a heritage,\nA heritage unto Israel his people.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.13",
      "edition_verse_id": "ASV1901:PSA.135.13",
      "verse": 13,
      "spans": [
        {
          "text": "Thy name, O Jehovah, ",
          "kind": "text"
        },
        {
          "text": "endureth",
          "kind": "supplied"
        },
        {
          "text": " for ever;\nThy memorial ",
          "kind": "text"
        },
        {
          "text": "name",
          "kind": "supplied"
        },
        {
          "text": ", O Jehovah, throughout all generations.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.14",
      "edition_verse_id": "ASV1901:PSA.135.14",
      "verse": 14,
      "spans": [
        {
          "text": "For Jehovah will judge his people,\nAnd repent himself concerning his servants.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.15",
      "edition_verse_id": "ASV1901:PSA.135.15",
      "verse": 15,
      "spans": [
        {
          "text": "The idols of the nations are silver and gold,\nThe work of men’s hands.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.16",
      "edition_verse_id": "ASV1901:PSA.135.16",
      "verse": 16,
      "spans": [
        {
          "text": "They have mouths, but they speak not;\nEyes have they, but they see not;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.17",
      "edition_verse_id": "ASV1901:PSA.135.17",
      "verse": 17,
      "spans": [
        {
          "text": "They have ears, but they hear not;\nNeither is there any breath in their mouths.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.18",
      "edition_verse_id": "ASV1901:PSA.135.18",
      "verse": 18,
      "spans": [
        {
          "text": "They that make them shall be like unto them;\nYea, every one that trusteth in them.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.19",
      "edition_verse_id": "ASV1901:PSA.135.19",
      "verse": 19,
      "spans": [
        {
          "text": "O house of Israel, bless ye Jehovah:\nO house of Aaron, bless ye Jehovah:",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.20",
      "edition_verse_id": "ASV1901:PSA.135.20",
      "verse": 20,
      "spans": [
        {
          "text": "O house of Levi, bless ye Jehovah:\nYe that fear Jehovah, bless ye Jehovah.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.21",
      "edition_verse_id": "ASV1901:PSA.135.21",
      "verse": 21,
      "spans": [
        {
          "text": "Blessed be Jehovah out of Zion,\nWho dwelleth at Jerusalem.Praise ye Jehovah.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "Praise for Jehovah’s wonderful works. Vanity of idols.",
      "before_verse": 1
    }
  ]
}
