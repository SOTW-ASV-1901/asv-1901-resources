{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PSA",
  "chapter": 88,
  "verses": [
    {
      "id": "PSA.88.1",
      "edition_verse_id": "ASV1901:PSA.88.1",
      "verse": 1,
      "spans": [
        {
          "text": "O Jehovah, the God of my salvation,\nI have cried day and night before thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.2",
      "edition_verse_id": "ASV1901:PSA.88.2",
      "verse": 2,
      "spans": [
        {
          "text": "Let my prayer enter into thy presence;\nIncline thine ear unto my cry.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.3",
      "edition_verse_id": "ASV1901:PSA.88.3",
      "verse": 3,
      "spans": [
        {
          "text": "For my soul is full of troubles,\nAnd my life draweth nigh unto Sheol.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.4",
      "edition_verse_id": "ASV1901:PSA.88.4",
      "verse": 4,
      "spans": [
        {
          "text": "I am reckoned with them that go down into the pit;\nI am as a man that hath no help,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.5",
      "edition_verse_id": "ASV1901:PSA.88.5",
      "verse": 5,
      "spans": [
        {
          "text": "Cast off among the dead,\nLike the slain that lie in the grave,\nWhom thou rememberest no more,\nAnd they are cut off from thy hand.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.6",
      "edition_verse_id": "ASV1901:PSA.88.6",
      "verse": 6,
      "spans": [
        {
          "text": "Thou hast laid me in the lowest pit,\nIn dark places, in the deeps.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.7",
      "edition_verse_id": "ASV1901:PSA.88.7",
      "verse": 7,
      "spans": [
        {
          "text": "Thy wrath lieth hard upon me,\nAnd thou hast afflicted me with all thy waves. [Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.8",
      "edition_verse_id": "ASV1901:PSA.88.8",
      "verse": 8,
      "spans": [
        {
          "text": "Thou hast put mine acquaintance far from me;\nThou hast made me an abomination unto them:\nI am shut up, and I cannot come forth.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.9",
      "edition_verse_id": "ASV1901:PSA.88.9",
      "verse": 9,
      "spans": [
        {
          "text": "Mine eye wasteth away by reason of affliction:\nI have called daily upon thee, O Jehovah;\nI have spread forth my hands unto thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.10",
      "edition_verse_id": "ASV1901:PSA.88.10",
      "verse": 10,
      "spans": [
        {
          "text": "Wilt thou show wonders to the dead?\nShall they that are deceased arise and praise thee? [Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.11",
      "edition_verse_id": "ASV1901:PSA.88.11",
      "verse": 11,
      "spans": [
        {
          "text": "Shall thy lovingkindness be declared in the grave?\nOr thy faithfulness in Destruction?",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.12",
      "edition_verse_id": "ASV1901:PSA.88.12",
      "verse": 12,
      "spans": [
        {
          "text": "Shall thy wonders be known in the dark?\nAnd thy righteousness in the land of forgetfulness?",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.13",
      "edition_verse_id": "ASV1901:PSA.88.13",
      "verse": 13,
      "spans": [
        {
          "text": "But unto thee, O Jehovah, have I cried;\nAnd in the morning shall my prayer come before thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.14",
      "edition_verse_id": "ASV1901:PSA.88.14",
      "verse": 14,
      "spans": [
        {
          "text": "Jehovah, why castest thou off my soul?\nWhy hidest thou thy face from me?",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.15",
      "edition_verse_id": "ASV1901:PSA.88.15",
      "verse": 15,
      "spans": [
        {
          "text": "I am afflicted and ready to die from my youth up:\nWhile I suffer thy terrors I am distracted.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.16",
      "edition_verse_id": "ASV1901:PSA.88.16",
      "verse": 16,
      "spans": [
        {
          "text": "Thy fierce wrath is gone over me;\nThy terrors have cut me off.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.17",
      "edition_verse_id": "ASV1901:PSA.88.17",
      "verse": 17,
      "spans": [
        {
          "text": "They came round about me like water all the day long;\nThey compassed me about together.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.18",
      "edition_verse_id": "ASV1901:PSA.88.18",
      "verse": 18,
      "spans": [
        {
          "text": "Lover and friend hast thou put far from me,\nAnd mine acquaintance into darkness.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "A petition to be saved from death.",
      "before_verse": 1
    },
    {
      "style": "d",
      "text": "A Song, a Psalm of the sons of Korah; for the Chief Musician; set to Mahalath Or, for singingLeannoth. Maschil of Heman the Ezrahite.",
      "before_verse": 1
    }
  ]
}
