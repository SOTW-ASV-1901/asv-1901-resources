{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PSA",
  "chapter": 115,
  "verses": [
    {
      "id": "PSA.115.1",
      "edition_verse_id": "ASV1901:PSA.115.1",
      "verse": 1,
      "spans": [
        {
          "text": "Not unto us, O Jehovah, not unto us,\nBut unto thy name give glory,\nFor thy lovingkindness, and for thy truth’s sake.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.115.2",
      "edition_verse_id": "ASV1901:PSA.115.2",
      "verse": 2,
      "spans": [
        {
          "text": "Wherefore should the nations say,\nWhere is now their God?",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.115.3",
      "edition_verse_id": "ASV1901:PSA.115.3",
      "verse": 3,
      "spans": [
        {
          "text": "But our God is in the heavens:\nHe hath done whatsoever he pleased.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.115.4",
      "edition_verse_id": "ASV1901:PSA.115.4",
      "verse": 4,
      "spans": [
        {
          "text": "Their idols are silver and gold,\nThe work of men’s hands.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.115.5",
      "edition_verse_id": "ASV1901:PSA.115.5",
      "verse": 5,
      "spans": [
        {
          "text": "They have mouths, but they speak not;\nEyes have they, but they see not;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.115.6",
      "edition_verse_id": "ASV1901:PSA.115.6",
      "verse": 6,
      "spans": [
        {
          "text": "They have ears, but they hear not;\nNoses have they, but they smell not;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.115.7",
      "edition_verse_id": "ASV1901:PSA.115.7",
      "verse": 7,
      "spans": [
        {
          "text": "They have hands, but they handle not;\nFeet have they, but they walk not;\nNeither speak they through their throat.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.115.8",
      "edition_verse_id": "ASV1901:PSA.115.8",
      "verse": 8,
      "spans": [
        {
          "text": "They that make them shall be like unto them;\nYea, every one that trusteth in them.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.115.9",
      "edition_verse_id": "ASV1901:PSA.115.9",
      "verse": 9,
      "spans": [
        {
          "text": "O Israel, trust thou in Jehovah:\nHe is their help and their shield.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.115.10",
      "edition_verse_id": "ASV1901:PSA.115.10",
      "verse": 10,
      "spans": [
        {
          "text": "O house of Aaron, trust ye in Jehovah:\nHe is their help and their shield.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.115.11",
      "edition_verse_id": "ASV1901:PSA.115.11",
      "verse": 11,
      "spans": [
        {
          "text": "Ye that fear Jehovah, trust in Jehovah:\nHe is their help and their shield.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.115.12",
      "edition_verse_id": "ASV1901:PSA.115.12",
      "verse": 12,
      "spans": [
        {
          "text": "Jehovah hath been mindful of us; he will bless ",
          "kind": "text"
        },
        {
          "text": "us",
          "kind": "supplied"
        },
        {
          "text": ":\nHe will bless the house of Israel;\nHe will bless the house of Aaron.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.115.13",
      "edition_verse_id": "ASV1901:PSA.115.13",
      "verse": 13,
      "spans": [
        {
          "text": "He will bless them that fear Jehovah,\nBoth small and great.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.115.14",
      "edition_verse_id": "ASV1901:PSA.115.14",
      "verse": 14,
      "spans": [
        {
          "text": "Jehovah increase you more and more,\nYou and your children.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.115.15",
      "edition_verse_id": "ASV1901:PSA.115.15",
      "verse": 15,
      "spans": [
        {
          "text": "Blessed are ye of Jehovah,\nWho made heaven and earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.115.16",
      "edition_verse_id": "ASV1901:PSA.115.16",
      "verse": 16,
      "spans": [
        {
          "text": "The heavens are the heavens of Jehovah;\nBut the earth hath he given to the children of men.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.115.17",
      "edition_verse_id": "ASV1901:PSA.115.17",
      "verse": 17,
      "spans": [
        {
          "text": "The dead praise not Jehovah,\nNeither any that go down into silence;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.115.18",
      "edition_verse_id": "ASV1901:PSA.115.18",
      "verse": 18,
      "spans": [
        {
          "text": "But we will bless Jehovah\nFrom this time forth and for evermore.Praise ye Jehovah.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "Heathen idols contrasted with Jehovah.",
      "before_verse": 1
    }
  ]
}
