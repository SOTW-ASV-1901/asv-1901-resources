      "edition_verse_id": "ASV1901:PSA.67.2",
      "verse": 2,
      "spans": [
        {
          "text": "That thy way may be known upon earth,\nThy salvation among all nations.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.67.3",
      "edition_verse_id": "ASV1901:PSA.67.3",
      "verse": 3,
      "spans": [
        {
          "text": "Let the peoples praise thee, O God;\nLet all the peoples praise thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.67.4",
      "edition_verse_id": "ASV1901:PSA.67.4",
      "verse": 4,
      "spans": [
        {
          "text": "Oh let the nations be glad and sing for joy;\nFor thou wilt judge the peoples with equity,\nAnd govern the nations upon earth. [Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.67.5",
      "edition_verse_id": "ASV1901:PSA.67.5",
      "verse": 5,
      "spans": [
        {
          "text": "Let the peoples praise thee, O God;\nLet all the peoples praise thee.",
