      "edition_verse_id": "ASV1901:PSA.67.6",
      "verse": 6,
      "spans": [
        {
          "text": "The earth hath yielded its increase:\nGod, even our own God, will bless us.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
