{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PSA",
  "chapter": 99,
  "verses": [
    {
      "id": "PSA.99.1",
      "edition_verse_id": "ASV1901:PSA.99.1",
      "verse": 1,
      "spans": [
        {
          "text": "Jehovah reigneth; let the peoples tremble:\nHe sitteth ",
          "kind": "text"
        },
        {
          "text": "above",
          "kind": "supplied"
        },
        {
          "text": " the cherubim; let the earth be moved.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.99.2",
      "edition_verse_id": "ASV1901:PSA.99.2",
      "verse": 2,
      "spans": [
        {
          "text": "Jehovah is great in Zion;\nAnd he is high above all the peoples.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.99.3",
      "edition_verse_id": "ASV1901:PSA.99.3",
      "verse": 3,
      "spans": [
        {
          "text": "Let them praise thy great and terrible name:\nHoly is he.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.99.4",
      "edition_verse_id": "ASV1901:PSA.99.4",
      "verse": 4,
      "spans": [
        {
          "text": "The king’s strength also loveth justice;\nThou dost establish equity;\nThou executest justice and righteousness in Jacob.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.99.5",
      "edition_verse_id": "ASV1901:PSA.99.5",
      "verse": 5,
      "spans": [
        {
          "text": "Exalt ye Jehovah our God,\nAnd worship at his footstool:\nHoly is he.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.99.6",
      "edition_verse_id": "ASV1901:PSA.99.6",
      "verse": 6,
      "spans": [
        {
          "text": "Moses and Aaron among his priests,\nAnd Samuel among them that call upon his name;\nThey called upon Jehovah, and he answered them.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.99.7",
      "edition_verse_id": "ASV1901:PSA.99.7",
      "verse": 7,
      "spans": [
        {
          "text": "He spake unto them in the pillar of cloud:\nThey kept his testimonies,\nAnd the statute that he gave them.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.99.8",
      "edition_verse_id": "ASV1901:PSA.99.8",
      "verse": 8,
      "spans": [
        {
          "text": "Thou answeredst them, O Jehovah our God:\nThou wast a God that forgavest them,\nThough thou tookest vengeance of their doings.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.99.9",
      "edition_verse_id": "ASV1901:PSA.99.9",
      "verse": 9,
      "spans": [
        {
          "text": "Exalt ye Jehovah our God,\nAnd worship at his holy hill;\nFor Jehovah our God is holy.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "Praise to Jehovah for his fidelity to Israel.",
      "before_verse": 1
    }
  ]
}
