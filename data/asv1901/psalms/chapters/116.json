{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PSA",
  "chapter": 116,
  "verses": [
    {
      "id": "PSA.116.1",
      "edition_verse_id": "ASV1901:PSA.116.1",
      "verse": 1,
      "spans": [
        {
          "text": "I love Jehovah, because he heareth\nMy voice and my supplications.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.2",
      "edition_verse_id": "ASV1901:PSA.116.2",
      "verse": 2,
      "spans": [
        {
          "text": "Because he hath inclined his ear unto me,\nTherefore will I call ",
          "kind": "text"
        },
        {
          "text": "upon him",
          "kind": "supplied"
        },
        {
          "text": " as long as I live.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.3",
      "edition_verse_id": "ASV1901:PSA.116.3",
      "verse": 3,
      "spans": [
        {
          "text": "The cords of death compassed me,\nAnd the pains of Sheol gat hold upon me:\nI found trouble and sorrow.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.4",
      "edition_verse_id": "ASV1901:PSA.116.4",
      "verse": 4,
      "spans": [
        {
          "text": "Then called I upon the name of Jehovah:\nO Jehovah, I beseech thee, deliver my soul.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.5",
      "edition_verse_id": "ASV1901:PSA.116.5",
      "verse": 5,
      "spans": [
        {
          "text": "Gracious is Jehovah, and righteous;\nYea, our God is merciful.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.6",
      "edition_verse_id": "ASV1901:PSA.116.6",
      "verse": 6,
      "spans": [
        {
          "text": "Jehovah preserveth the simple:\nI was brought low, and he saved me.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.7",
      "edition_verse_id": "ASV1901:PSA.116.7",
      "verse": 7,
      "spans": [
        {
          "text": "Return unto thy rest, O my soul;\nFor Jehovah hath dealt bountifully with thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.8",
      "edition_verse_id": "ASV1901:PSA.116.8",
      "verse": 8,
      "spans": [
        {
          "text": "For thou hast delivered my soul from death,\nMine eyes from tears,",
          "kind": "text"
        },
        {
          "text": "And",
          "kind": "supplied"
        },
        {
          "text": " my feet from falling.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.9",
      "edition_verse_id": "ASV1901:PSA.116.9",
      "verse": 9,
      "spans": [
        {
          "text": "I will walk before Jehovah\nIn the land of the living.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.10",
      "edition_verse_id": "ASV1901:PSA.116.10",
      "verse": 10,
      "spans": [
        {
          "text": "I believe, for I will speak:\nI was greatly afflicted:",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.11",
      "edition_verse_id": "ASV1901:PSA.116.11",
      "verse": 11,
      "spans": [
        {
          "text": "I said in my haste,\nAll men are liars.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.12",
      "edition_verse_id": "ASV1901:PSA.116.12",
      "verse": 12,
      "spans": [
        {
          "text": "What shall I render unto Jehovah\nFor all his benefits toward me?",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.13",
      "edition_verse_id": "ASV1901:PSA.116.13",
      "verse": 13,
      "spans": [
        {
          "text": "I will take the cup of salvation,\nAnd call upon the name of Jehovah.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.14",
      "edition_verse_id": "ASV1901:PSA.116.14",
      "verse": 14,
      "spans": [
        {
          "text": "I will pay my vows unto Jehovah,\nYea, in the presence of all his people.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.15",
      "edition_verse_id": "ASV1901:PSA.116.15",
      "verse": 15,
      "spans": [
        {
          "text": "Precious in the sight of Jehovah\nIs the death of his saints.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.16",
      "edition_verse_id": "ASV1901:PSA.116.16",
      "verse": 16,
      "spans": [
        {
          "text": "O Jehovah, truly I am thy servant:\nI am thy servant, the son of thy handmaid;\nThou hast loosed my bonds.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.17",
      "edition_verse_id": "ASV1901:PSA.116.17",
      "verse": 17,
      "spans": [
        {
          "text": "I will offer to thee the sacrifice of thanksgiving,\nAnd will call upon the name of Jehovah.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.18",
      "edition_verse_id": "ASV1901:PSA.116.18",
      "verse": 18,
      "spans": [
        {
          "text": "I will pay my vows unto Jehovah,\nYea, in the presence of all his people,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.19",
      "edition_verse_id": "ASV1901:PSA.116.19",
      "verse": 19,
      "spans": [
        {
          "text": "In the courts of Jehovah’s house,\nIn the midst of thee, O Jerusalem.Praise ye Jehovah.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "Thanksgiving for deliverance from death.",
      "before_verse": 1
    }
  ]
}
