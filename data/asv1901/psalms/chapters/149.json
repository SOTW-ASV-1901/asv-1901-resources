{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PSA",
  "chapter": 149,
  "verses": [
    {
      "id": "PSA.149.1",
      "edition_verse_id": "ASV1901:PSA.149.1",
      "verse": 1,
      "spans": [
        {
          "text": "Praise ye Jehovah.\nSing unto Jehovah a new song,\nAnd his praise in the assembly of the saints.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.149.2",
      "edition_verse_id": "ASV1901:PSA.149.2",
      "verse": 2,
      "spans": [
        {
          "text": "Let Israel rejoice in him that made him:\nLet the children of Zion be joyful in their King.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.149.3",
      "edition_verse_id": "ASV1901:PSA.149.3",
      "verse": 3,
      "spans": [
        {
          "text": "Let them praise his name in the dance:\nLet them sing praises unto him with timbrel and harp.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.149.4",
      "edition_verse_id": "ASV1901:PSA.149.4",
      "verse": 4,
      "spans": [
        {
          "text": "For Jehovah taketh pleasure in his people:\nHe will beautify the meek with salvation.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.149.5",
      "edition_verse_id": "ASV1901:PSA.149.5",
      "verse": 5,
      "spans": [
        {
          "text": "Let the saints exult in glory:\nLet them sing for joy upon their beds.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.149.6",
      "edition_verse_id": "ASV1901:PSA.149.6",
      "verse": 6,
      "spans": [
        {
          "text": "Let",
          "kind": "supplied"
        },
        {
          "text": " the high praises of God ",
          "kind": "text"
        },
        {
          "text": "be",
          "kind": "supplied"
        },
        {
          "text": " in their mouth,\nAnd a two-edged sword in their hand;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.149.7",
      "edition_verse_id": "ASV1901:PSA.149.7",
      "verse": 7,
      "spans": [
        {
          "text": "To execute vengeance upon the nations,\nAnd punishments upon the peoples;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.149.8",
      "edition_verse_id": "ASV1901:PSA.149.8",
      "verse": 8,
      "spans": [
        {
          "text": "To bind their kings with chains,\nAnd their nobles with fetters of iron;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.149.9",
      "edition_verse_id": "ASV1901:PSA.149.9",
      "verse": 9,
      "spans": [
        {
          "text": "To execute upon them the judgment written:This honor have all his saints.Praise ye Jehovah.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "Israel invoked to praise Jehovah.",
      "before_verse": 1
    }
  ]
}
