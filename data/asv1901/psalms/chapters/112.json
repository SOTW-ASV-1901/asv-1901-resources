{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PSA",
  "chapter": 112,
  "verses": [
    {
      "id": "PSA.112.1",
      "edition_verse_id": "ASV1901:PSA.112.1",
      "verse": 1,
      "spans": [
        {
          "text": "Praise ye Jehovah.\nBlessed is the man that feareth Jehovah,\nThat delighteth greatly in his commandments.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.112.2",
      "edition_verse_id": "ASV1901:PSA.112.2",
      "verse": 2,
      "spans": [
        {
          "text": "His seed shall be mighty upon earth:\nThe generation of the upright shall be blessed.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.112.3",
      "edition_verse_id": "ASV1901:PSA.112.3",
      "verse": 3,
      "spans": [
        {
          "text": "Wealth and riches are in his house;\nAnd his righteousness endureth for ever.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.112.4",
      "edition_verse_id": "ASV1901:PSA.112.4",
      "verse": 4,
      "spans": [
        {
          "text": "Unto the upright there ariseth light in the darkness:",
          "kind": "text"
        },
        {
          "text": "He is",
          "kind": "supplied"
        },
        {
          "text": " gracious, and merciful, and righteous.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.112.5",
      "edition_verse_id": "ASV1901:PSA.112.5",
      "verse": 5,
      "spans": [
        {
          "text": "Well is it with the man that dealeth graciously and lendeth;\nHe shall maintain his cause in judgment.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.112.6",
      "edition_verse_id": "ASV1901:PSA.112.6",
      "verse": 6,
      "spans": [
        {
          "text": "For he shall never be moved;\nThe righteous shall be had in everlasting remembrance.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.112.7",
      "edition_verse_id": "ASV1901:PSA.112.7",
      "verse": 7,
      "spans": [
        {
          "text": "He shall not be afraid of evil tidings:\nHis heart is fixed, trusting in Jehovah.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.112.8",
      "edition_verse_id": "ASV1901:PSA.112.8",
      "verse": 8,
      "spans": [
        {
          "text": "His heart is established, he shall not be afraid,\nUntil he see ",
          "kind": "text"
        },
        {
          "text": "his desire",
          "kind": "supplied"
        },
        {
          "text": " upon his adversaries.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.112.9",
      "edition_verse_id": "ASV1901:PSA.112.9",
      "verse": 9,
      "spans": [
        {
          "text": "He hath dispersed, he hath given to the needy;\nHis righteousness endureth for ever:\nHis horn shall be exalted with honor.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.112.10",
      "edition_verse_id": "ASV1901:PSA.112.10",
      "verse": 10,
      "spans": [
        {
          "text": "The wicked shall see it, and be grieved;\nHe shall gnash with his teeth, and melt away:\nThe desire of the wicked shall perish.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "Prosperity of him that fears Jehovah.",
      "before_verse": 1
    }
  ]
}
