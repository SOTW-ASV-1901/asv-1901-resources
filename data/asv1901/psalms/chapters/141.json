{
  "schema_version": "1.0.0",
  "edition_id": "ASV1901",
  "book_code": "PSA",
  "chapter": 141,
  "verses": [
    {
      "id": "PSA.141.1",
      "edition_verse_id": "ASV1901:PSA.141.1",
      "verse": 1,
      "spans": [
        {
          "text": "Jehovah, I have called upon thee; make haste unto me:\nGive ear unto my voice, when I call unto thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.141.2",
      "edition_verse_id": "ASV1901:PSA.141.2",
      "verse": 2,
      "spans": [
        {
          "text": "Let my prayer be set forth as incense before thee;\nThe lifting up of my hands as the evening sacrifice.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.141.3",
      "edition_verse_id": "ASV1901:PSA.141.3",
      "verse": 3,
      "spans": [
        {
          "text": "Set a watch, O Jehovah, before my mouth;\nKeep the door of my lips.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.141.4",
      "edition_verse_id": "ASV1901:PSA.141.4",
      "verse": 4,
      "spans": [
        {
          "text": "Incline not my heart to any evil thing,\nTo practise deeds of wickedness\nWith men that work iniquity:\nAnd let me not eat of their dainties.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.141.5",
      "edition_verse_id": "ASV1901:PSA.141.5",
      "verse": 5,
      "spans": [
        {
          "text": "Let the righteous smite me, ",
          "kind": "text"
        },
        {
          "text": "it shall be",
          "kind": "supplied"
        },
        {
          "text": " a kindness;\nAnd let him reprove me, ",
          "kind": "text"
        },
        {
          "text": "it shall be as",
          "kind": "supplied"
        },
        {
          "text": " oil upon the head;\nLet not my head refuse it:\nFor even in their wickedness shall my prayer continue.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.141.6",
      "edition_verse_id": "ASV1901:PSA.141.6",
      "verse": 6,
      "spans": [
        {
          "text": "Their judges are thrown down by the sides of the rock;\nAnd they shall hear my words; for they are sweet.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.141.7",
      "edition_verse_id": "ASV1901:PSA.141.7",
      "verse": 7,
      "spans": [
        {
          "text": "As when one ploweth and cleaveth the earth,\nOur bones are scattered at the mouth of Sheol.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.141.8",
      "edition_verse_id": "ASV1901:PSA.141.8",
      "verse": 8,
      "spans": [
        {
          "text": "For mine eyes are unto thee, O Jehovah the Lord:\nIn thee do I take refuge; leave not my soul destitute.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.141.9",
      "edition_verse_id": "ASV1901:PSA.141.9",
      "verse": 9,
      "spans": [
        {
          "text": "Keep me from the snare which they have laid for me,\nAnd from the gins of the workers of iniquity.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.141.10",
      "edition_verse_id": "ASV1901:PSA.141.10",
      "verse": 10,
      "spans": [
        {
          "text": "Let the wicked fall into their own nets,\nWhilst that I withal escape.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ],
  "headings": [
    {
      "style": "s1",
      "text": "An evening prayer for sanctification and protection.",
      "before_verse": 1
    },
    {
      "style": "d",
      "text": "A Psalm of David.",
      "before_verse": 1
    }
  ]
}
