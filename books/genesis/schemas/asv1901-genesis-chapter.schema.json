{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://stewards-of-the-way.github.io/bible-foundation/schemas/asv1901-genesis-chapter.schema.json",
  "title":"SOTW ASV1901 Genesis chapter, canonical distribution projection",
  "type":"object","additionalProperties":false,
  "required":["schema_version","edition_id","book_code","chapter","verses"],
  "properties":{
    "schema_version":{"const":"1.0.0"},"edition_id":{"const":"ASV1901"},"book_code":{"const":"GEN"},
    "chapter":{"type":"integer","minimum":1,"maximum":50},
    "verses":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,"required":["id","edition_verse_id","verse","spans","paragraph_start"],
      "properties":{
        "id":{"type":"string","pattern":"^GEN\\.[1-9][0-9]*\\.[1-9][0-9]*$"},
        "edition_verse_id":{"type":"string","pattern":"^ASV1901:GEN\\.[1-9][0-9]*\\.[1-9][0-9]*$"},
        "verse":{"type":"integer","minimum":1},"paragraph_start":{"type":"boolean"},
        "spans":{"type":"array","minItems":1,"items":{"type":"object","required":["text","kind"],"additionalProperties":false,
          "properties":{"text":{"type":"string","minLength":1},"kind":{"enum":["text","supplied"]}}}}
      }
    }}
  }
}
